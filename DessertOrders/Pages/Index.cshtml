@page
@model IndexModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="page">
    <main class="content">
        <!-- Ліва промо-колонка з баннером -->
        <div class="left">
            <img src="~/images/images-1.jfif" alt="Десерт">
            <div class="overlay"></div>
            <div class="brand-text">
                <h2>Життя стає трішки солодшим.</h2>
                <p>Готуємо вручну, вибираємо найкращі інгредієнти та дбайливо доставляємо ваші улюблені десерти.</p>
            </div>
        </div>

        <!-- Права колонка з формою реєстрації -->
        <div class="right">
            <span class="small-title">РАДІ ЗНАЙОМСТВУ</span>
            <h1>Ваша солодка історія</h1>
            <p class="description">
                Створіть акаунт, щоб замовляти улюблені десерти та зберігати приємні моменти.
            </p>

            <form method="post">
                <div class="form-group">
                    <label>Ім'я та прізвище</label>
                    <input type="text" asp-for="InputUser.Name" placeholder="Ім'я та Прізвище">
                </div>

                <div class="form-group">
                    <label>Електронна пошта</label>
                    <input type="email" asp-for="InputUser.Email" placeholder="example@gmail.com">
                </div>

                <div class="form-group">
                    <label>Телефон</label>
                    <input type="text" asp-for="InputUser.Phone" placeholder="+380 (99) 000-00-00">
                </div>

                <div class="password-row">
                    <div class="password-field">
                        <label>Пароль</label>
                        <input type="password" asp-for="InputUser.Password">
                    </div>

                    <div class="password-field">
                        <label>Повторіть пароль</label>
                        <input type="password">
                    </div>
                </div>

                <button type="submit">Створити акаунт</button>

                <div class="form-footer-text">
                    Вже є акаунт? <a asp-page="/Login">Увійти</a>
                </div>
            </form>
        </div>
    </main>

    <footer class="footer">
        <div>© 2026 Крихітка. Зроблено з любов'ю.</div>
    </footer>
</div>