@page
@model IndexModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="page">
    <header class="header">
        <div class="logo">
            <h1>крихітка.</h1>
            <span>КОНДИТЕРСЬКА З ЛЮБОВ'Ю</span>
        </div>
        <div class="account">
            Особистий кабінет
        </div>
    </header>


    <main class="content">
        <div class="left">
            <img src="~/images/images-1.jfif" alt="Десерт">
            <div class="overlay"></div>
            <div class = "brand-text">
                <h2>Життя стає трішки солодшим.</h2>
                <p>Готуємо вручну, вибираємо найкращі інгредієнти та дбайливо доставляємо ваші улюблені десерти.</p>
            </div>
        </div>


        <div class="right">
            <span class="small-title">
                РАДІ ЗНАЙОМСТВУ
            </span>
            <h1>Ваша солодка історія</h1>
            <p class="description">
                Створіть акаунт, щоб замовляти улюблені десерти та зберігати приємні моменти.
            </p>
            <form>
                <div class = "form-group">
                    <label>Ім'я та прізвище</label>
                    <input type="text">
                </div>

                <div class = "form-group">
                    <label>Електронна пошта</label>
                    <input type="email">
                </div>

                <div class = "form-group">
                    <label>Телефон</label>
                    <input type="text">
                </div>

                <div class="password-row">
                    <div class="password-field">
                        <label>Пароль</label>
                        <input type="password">
                    </div>


                    <div class="password-field">
                        <label>Повторіть пароль</label>
                        <input type="password">
                    </div>
                </div>

                <button type="submit">
                    Створити акаунт
                </button>
            </form>
        </div>
    </main>

    <footer class="footer">
        <div>© 2026 Крихітка. Зроблено з любов'ю.</div>
    </footer>
</div>